# not upstream: copies the XR data into the Orbiter folder; a file that already exists is kept (user edits, XR2 package files)
set(dst "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
file(GLOB_RECURSE files RELATIVE "${XR_SRC}/Orbiter" "${XR_SRC}/Orbiter/*")
set(prefs
	"XRVessels/DeltaGliderXR1/DeltaGliderXR1Prefs.cfg"
	"XRVessels/XR2Ravenstar/XR2RavenstarPrefs.cfg"
	"XRVessels/XR5Vanguard/XR5VanguardPrefs.cfg")
set(added 0)
set(kept 0)
foreach(f ${files})
	if(f MATCHES "XR3Phoenix")
		continue()
	endif()
	if(EXISTS "${dst}/${f}")
		math(EXPR kept "${kept}+1")
	else()
		get_filename_component(d "${dst}/${f}" DIRECTORY)
		file(COPY "${XR_SRC}/Orbiter/${f}" DESTINATION "${d}")
		math(EXPR added "${added}+1")
	endif()
endforeach()
foreach(p ${prefs})
	get_filename_component(n "${p}" NAME)
	if(EXISTS "${dst}/Config/${n}")
		math(EXPR kept "${kept}+1")
	else()
		file(COPY "${XR_SRC}/${p}" DESTINATION "${dst}/Config")
		math(EXPR added "${added}+1")
	endif()
endforeach()
message(STATUS "XR data: ${added} files added, ${kept} existing files kept")
